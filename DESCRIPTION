Package: PscoresPlus
Type: Package
Title: Extended P-Scores for Treatment Ranking in Network Meta-Analysis
Version: 0.1.0
Authors@R: c(
    person("Sofia", "Tsokani", email = "stsokani@auth.gr", role = c("aut", "cre")),
    person("Augustine", "Wigle", role = c("aut")),
    person("Dimitris", "Mavridis", role = c("aut")),
